# Neon Postgres connection string (pooled endpoint recommended)
DATABASE_URL=postgres://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# AWS S3 configuration
AWS_REGION=us-east-1
S3_BUCKET=personal-context-prod

# AWS credentials (not needed if using IAM role on Amplify)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: local dev mode proxy target for Next.js API routes
# LOCAL_BACKEND_URL=http://127.0.0.1:9876

# Optional: presigned URL expiration in seconds (default: 3600)
# PRESIGNED_URL_EXPIRY_SECONDS=3600
